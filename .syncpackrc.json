{
  "$schema": "https://unpkg.com/syncpack@14/dist/schema.json",
  "strict": false,
  "semverGroups": [
    {
      "label": "Prisma-generated clients use exact versions",
      "packages": ["prisma-client-*"],
      "range": ""
    },
    {
      "label": "Catalog-aligned deps use semver caret range",
      "range": "^",
      "dependencies": ["**"],
      "packages": ["**"]
    }
  ]
}

// PharmaCare SaaS - Multi-tenant Pharmacy Management
// Architecture: public (SaaS core) + schema-per-tenant (pharmacy1, pharmacy2, etc.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "tenant_template"]
}

// ============================================
// PUBLIC SCHEMA (SaaS Core)
// ============================================

model Tenant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(255)
  schemaName String   @unique @map("schema_name") @db.VarChar(100)
  status     String   @default("active") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  posDevices           PosDevice[]
  domains              Domain[]
  reconciliationRuns   ReconciliationRun[]
  reconciliationLogs ReconciliationLog[]

  @@schema("public")
}

model PosDevice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  deviceCode       String   @unique @map("device_code") @db.VarChar(128)
  displayName      String?  @map("display_name") @db.VarChar(255)
  status           String   @default("active") @db.VarChar(20)
  deviceSecretHash String   @map("device_secret_hash") @db.VarChar(128)
  branchId         String?  @map("branch_id") @db.Uuid
  boundAt          DateTime @default(now()) @map("bound_at") @db.Timestamp(6)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamp(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, deviceCode])
  @@map("pos_devices")
  @@schema("public")
}

model Domain {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  domain    String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@schema("public")
}

model SystemUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar(255)
  password  String   @db.Text
  name      String?  @db.VarChar(200)
  role      String   @default("super_admin") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("super_admins")
  @@schema("public")
}

model ReconciliationRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamp(6)
  status     String    @db.VarChar(20)
  summary    Json?     @db.JsonB

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   ReconciliationLog[]

  @@index([tenantId, startedAt(sort: Desc)])
  @@map("reconciliation_runs")
  @@schema("public")
}

model ReconciliationLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  type      String   @db.VarChar(32)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  severity  String   @db.VarChar(16)
  message   String   @db.Text
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  run    ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([runId])
  @@index([tenantId, severity])
  @@index([tenantId, type])
  @@map("reconciliation_logs")
  @@schema("public")
}

// ============================================
// TENANT SCHEMA TEMPLATE
// Used for migrations. Each tenant (pharmacy1, pharmacy2) gets a copy.
// Runtime: SET search_path TO <schema_name>;
// ============================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?  @db.VarChar(200)
  staffId   String?  @map("staff_id") @db.VarChar(120)
  email     String?  @unique @db.VarChar(200)
  password  String?  @db.Text
  pinHash   String?  @map("pin_hash") @db.Text
  roleId    String?  @map("role_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  role        Role?        @relation(fields: [roleId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  posSessions PosSession[]

  @@index([staffId])
  @@index([branchId])
  @@schema("tenant_template")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  productCategories ProductCategory[]
  products          Product[]
  purchases         Purchase[]
  inventory         Inventory[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  returnVouchers    ReturnVoucher[]
  batches           Batch[]
  expenses          Expense[]
  patientLoans      PatientLoan[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  users             User[]
  posSessions       PosSession[]

  @@schema("tenant_template")
}

model Role {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(50)

  users           User[]
  rolePermissions RolePermission[]

  @@schema("tenant_template")
}

model Permission {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(100)

  rolePermissions RolePermission[]

  @@schema("tenant_template")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@schema("tenant_template")
}

model ProductCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text
  slug        String?   @db.VarChar(255)
  products    Product[]
  children    ProductCategory[] @relation("CategoryHierarchy")
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([parentId])
  @@index([branchId, name])
  @@schema("tenant_template")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  name        String   @db.VarChar(255)
  genericName String?  @map("generic_name") @db.VarChar(255)
  barcode     String?  @db.VarChar(100)
  listPrice   Decimal  @default(0) @map("list_price") @db.Decimal(10, 2)
  strength    String?  @db.VarChar(100)
  formulation String?  @db.VarChar(100)
  categoryId  String?  @map("category_id") @db.Uuid
  unit        String?  @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  branch          Branch?          @relation(fields: [branchId], references: [id])
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  purchaseItems   PurchaseItem[]
  batches         Batch[]
  inventory       Inventory[]
  saleItems       SaleItem[]
  saleReturnItems SaleReturnItem[]

  @@index([barcode])
  @@index([branchId])
  @@index([createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([branchId, createdAt(sort: Desc)])
  @@schema("tenant_template")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(255)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  purchases Purchase[]

  @@schema("tenant_template")
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  patientLoans PatientLoan[]

  @@schema("tenant_template")
}

model PatientLoan {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  saleId      String?   @map("sale_id") @db.Uuid
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  amountPaid  Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status      String    @default("ongoing") @db.VarChar(20)
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch?              @relation(fields: [branchId], references: [id])
  sale     Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments PatientLoanPayment[]

  @@index([branchId])
  @@index([customerId])
  @@schema("tenant_template")
}

model PatientLoanPayment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId        String   @map("loan_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String?  @map("payment_method") @db.VarChar(50)
  paymentDate   DateTime @default(now()) @map("payment_date") @db.Timestamp(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  loan PatientLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@schema("tenant_template")
}

model Purchase {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId    String?   @map("supplier_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  invoiceNumber String?   @map("invoice_number") @db.VarChar(100)
  totalAmount   Decimal?  @map("total_amount") @db.Decimal(12, 2)
  purchaseDate  DateTime? @map("purchase_date") @db.Date
  onCredit      Boolean   @default(false) @map("on_credit")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  purchaseItems PurchaseItem[]

  @@index([branchId])
  @@index([supplierId])
  @@index([invoiceNumber])
  @@index([branchId, createdAt(sort: Desc)])
  @@schema("tenant_template")
}

model PurchaseItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId   String    @map("purchase_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  productId    String?   @map("product_id") @db.Uuid
  batchId      String?   @map("batch_id") @db.Uuid
  quantity     Int?
  costPrice    Decimal?  @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal?  @map("selling_price") @db.Decimal(10, 2)
  expiryDate   DateTime? @map("expiry_date") @db.Date

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([branchId])
  @@schema("tenant_template")
}

model Batch {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  productId    String?   @map("product_id") @db.Uuid
  batchNumber  String?   @map("batch_number") @db.VarChar(100)
  expiryDate   DateTime? @map("expiry_date") @db.Date
  quantity     Int?
  costPrice    Decimal?  @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal?  @map("selling_price") @db.Decimal(10, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  product         Product?         @relation(fields: [productId], references: [id])
  branch          Branch?          @relation(fields: [branchId], references: [id])
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  saleReturnItems SaleReturnItem[]

  @@index([expiryDate])
  @@index([branchId, productId, expiryDate, createdAt])
  @@schema("tenant_template")
}

model Inventory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  quantity     Int      @default(0)
  reorderLevel Int      @default(10) @map("reorder_level")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product Product? @relation(fields: [productId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@schema("tenant_template")
}

model PosSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  deviceId    String?   @map("device_id") @db.Uuid
  staffUserId String?   @map("staff_user_id") @db.Uuid
  status      String    @default("open") @db.VarChar(20)
  openedAt    DateTime  @default(now()) @map("opened_at") @db.Timestamp(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamp(6)

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffUser     User?          @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  posStatements PosStatement[]
  sales         Sale[]

  @@index([branchId, status])
  @@index([branchId, openedAt(sort: Desc)])
  @@map("pos_sessions")
  @@schema("tenant_template")
}

model PosStatement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  status         String    @default("open") @db.VarChar(20)
  journalEntryId String?   @map("journal_entry_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  postedAt       DateTime? @map("posted_at") @db.Timestamp(6)

  session PosSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lines   PosStatementLine[]

  @@index([sessionId])
  @@map("pos_statements")
  @@schema("tenant_template")
}

model PosStatementLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId    String  @map("statement_id") @db.Uuid
  paymentBucket  String  @map("payment_bucket") @db.VarChar(32)
  expectedAmount Decimal @default(0) @map("expected_amount") @db.Decimal(14, 2)
  actualAmount   Decimal @default(0) @map("actual_amount") @db.Decimal(14, 2)
  difference     Decimal @default(0) @map("difference") @db.Decimal(14, 2)

  statement PosStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, paymentBucket], map: "pos_statement_lines_statement_bucket_unique")
  @@map("pos_statement_lines")
  @@schema("tenant_template")
}

model Sale {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  posSessionId   String?  @map("pos_session_id") @db.Uuid
  receiptNumber  String?  @map("receipt_number") @db.VarChar(20)
  totalAmount    Decimal? @map("total_amount") @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(10, 2)
  tax            Decimal  @default(0) @db.Decimal(10, 2)
  saleDate       DateTime @default(now()) @map("sale_date") @db.Timestamp(6)

  branch          Branch?          @relation(fields: [branchId], references: [id])
  posSession      PosSession?      @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  saleItems       SaleItem[]
  saleReturns     SaleReturn[]
  returnVouchers  ReturnVoucher[]
  payments        Payment[]
  patientLoans    PatientLoan[]

  @@unique([branchId, receiptNumber], map: "sales_branch_receipt_unique")
  @@index([saleDate])
  @@index([branchId, saleDate(sort: Desc)])
  @@index([branchId, receiptNumber])
  @@index([posSessionId])
  @@schema("tenant_template")
}

model SaleItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId          String   @map("sale_id") @db.Uuid
  branchId        String?  @map("branch_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  batchId         String?  @map("batch_id") @db.Uuid
  quantity        Int?
  price           Decimal? @db.Decimal(10, 2)
  total           Decimal? @db.Decimal(10, 2)
  miscChargeKind  String?  @map("misc_charge_kind") @db.VarChar(32)

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id])
  product         Product?         @relation(fields: [productId], references: [id])
  batch           Batch?           @relation(fields: [batchId], references: [id])
  saleReturnItems SaleReturnItem[]
  returnVouchers  ReturnVoucher[]

  @@index([saleId])
  @@index([productId])
  @@index([branchId])
  @@index([branchId, productId])
  @@schema("tenant_template")
}

model SaleReturn {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid
  reason        String?  @db.Text
  returnDate    DateTime @default(now()) @map("return_date") @db.Timestamp(6)
  refundMethod  String?  @map("refund_method") @db.VarChar(50)
  refundAmount  Decimal? @map("refund_amount") @db.Decimal(12, 2)

  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id])
  saleReturnItems  SaleReturnItem[]
  returnVouchers   ReturnVoucher[]

  @@index([saleId])
  @@index([returnDate])
  @@index([branchId, returnDate(sort: Desc)])
  @@schema("tenant_template")
}

model ReturnVoucher {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  saleId       String    @map("sale_id") @db.Uuid
  saleItemId   String    @map("sale_item_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal   @map("unit_price") @db.Decimal(10, 2)
  token        String    @unique @db.VarChar(80)
  status       String    @default("pending") @db.VarChar(20)
  reason       String?   @db.Text
  saleReturnId String?   @map("sale_return_id") @db.Uuid
  expiresAt    DateTime? @map("expires_at") @db.Timestamp(6)
  usedAt       DateTime? @map("used_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  branch     Branch      @relation(fields: [branchId], references: [id])
  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem   SaleItem    @relation(fields: [saleItemId], references: [id])
  saleReturn SaleReturn? @relation(fields: [saleReturnId], references: [id])

  @@index([saleId])
  @@index([branchId])
  @@index([token])
  @@schema("tenant_template")
}

model SaleReturnItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleReturnId String  @map("sale_return_id") @db.Uuid
  productId    String? @map("product_id") @db.Uuid
  batchId      String? @map("batch_id") @db.Uuid
  saleItemId   String? @map("sale_item_id") @db.Uuid
  quantity     Int

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
  batch      Batch?     @relation(fields: [batchId], references: [id])
  saleItem   SaleItem?  @relation(fields: [saleItemId], references: [id])

  @@index([saleReturnId])
  @@schema("tenant_template")
}

model Payment {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId String?  @map("sale_id") @db.Uuid
  method String?  @db.VarChar(50)
  amount Decimal? @db.Decimal(10, 2)
  paidAt DateTime @default(now()) @map("paid_at") @db.Timestamp(6)

  sale Sale? @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@schema("tenant_template")
}

model ExpenseCategory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?   @db.VarChar(255)
  glAccountKey  String?   @map("gl_account_key") @db.VarChar(50)
  expenses      Expense[]

  @@schema("tenant_template")
}

model Expense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  amount      Decimal?  @db.Decimal(12, 2)
  description String?   @db.Text
  expenseDate DateTime? @map("expense_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  category ExpenseCategory? @relation(fields: [categoryId], references: [id])
  branch   Branch?          @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([createdAt(sort: Desc)])
  @@schema("tenant_template")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String?  @db.VarChar(255)
  message   String?  @db.Text
  type      String?  @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@schema("tenant_template")
}

// Tenant database schema: all ERP/POS tables live in the tenant database public schema.

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/tenant-client"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?  @db.VarChar(200)
  staffId   String?  @map("staff_id") @db.VarChar(120)
  email     String?  @unique @db.VarChar(200)
  password  String?  @db.Text
  pinHash   String?  @map("pin_hash") @db.Text
  roleId    String?  @map("role_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  role        Role?        @relation(fields: [roleId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  posSessions PosSession[]

  @@index([staffId])
  @@index([branchId])
  @@map("users")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?  @db.VarChar(255)
  code      String?  @db.VarChar(32)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  productCategories ProductCategory[]
  products          Product[]
  purchases         Purchase[]
  inventory         Inventory[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  returnVouchers    ReturnVoucher[]
  batches           Batch[]
  expenses          Expense[]
  patientLoans      PatientLoan[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  users             User[]
  posSessions       PosSession[]
  offerRedemptions  OfferRedemption[]
  chartOfAccounts   ChartOfAccount[]
  journalEntries    JournalEntry[]
  @@map("branches")
}

model Role {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String  @unique @db.VarChar(50)
  description  String? @db.Text
  active       Boolean @default(true)
  isSystemRole Boolean @default(false) @map("is_system_role")

  users           User[]
  rolePermissions RolePermission[]
  @@map("roles")
}

model Permission {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(100)

  rolePermissions RolePermission[]
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ProductCategory {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String?           @map("branch_id") @db.Uuid
  parentId    String?           @map("parent_id") @db.Uuid
  name        String            @db.VarChar(255)
  description String?           @db.Text
  slug        String?           @db.VarChar(255)
  products    Product[]
  offerRules  OfferRule[]
  children    ProductCategory[] @relation("CategoryHierarchy")
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([parentId])
  @@index([branchId, name])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  itemNo      String?  @map("item_no") @db.VarChar(50)
  name        String   @db.VarChar(255)
  genericName String?  @map("generic_name") @db.VarChar(255)
  barcode     String?  @db.VarChar(100)
  listPrice   Decimal  @default(0) @map("list_price") @db.Decimal(10, 2)
  strength    String?  @db.VarChar(100)
  formulation String?  @db.VarChar(100)
  categoryId  String?  @map("category_id") @db.Uuid
  supplierId  String?  @map("supplier_id") @db.Uuid
  unit        String?  @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  branch               Branch?                  @relation(fields: [branchId], references: [id])
  category             ProductCategory?         @relation(fields: [categoryId], references: [id])
  supplier             Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseItems        PurchaseItem[]
  batches              Batch[]
  inventory            Inventory[]
  saleItems            SaleItem[]
  saleReturnItems      SaleReturnItem[]
  productSuppliers     ProductSupplier[]
  productUoms          ProductUom[]
  productUomPrices     ProductUomPrice[]
  productUomBarcodes   ProductUomBarcode[]
  supplierUomCosts     ProductSupplierUomCost[]
  supplierPriceHistory SupplierPriceHistory[]
  priceGroupPrices     ProductPriceGroupPrice[]
  priceHistory         ProductPriceHistory[]
  offerRules           OfferRule[]
  offerRedemptions     OfferRedemption[]

  @@index([barcode])
  @@index([branchId])
  @@index([createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([supplierId])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("products")
}

model Uom {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(100)
  symbol    String?  @db.VarChar(32)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  productUoms          ProductUom[]
  productUomPrices     ProductUomPrice[]
  productUomBarcodes   ProductUomBarcode[]
  priceGroupPrices     ProductPriceGroupPrice[]
  priceHistory         ProductPriceHistory[]
  supplierUomCosts     ProductSupplierUomCost[]
  supplierPriceHistory SupplierPriceHistory[]
  purchaseItems        PurchaseItem[]
  saleItems            SaleItem[]
  saleReturnItems      SaleReturnItem[]
  returnVouchers       ReturnVoucher[]

  @@map("uoms")
}

model ProductUom {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  uomId                  String   @map("uom_id") @db.Uuid
  conversionFactorToBase Decimal  @map("conversion_factor_to_base") @db.Decimal(18, 6)
  isBase                 Boolean  @default(false) @map("is_base")
  isPurchaseDefault      Boolean  @default(false) @map("is_purchase_default")
  isSalesDefault         Boolean  @default(false) @map("is_sales_default")
  isPosDefault           Boolean  @default(false) @map("is_pos_default")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom     Uom     @relation(fields: [uomId], references: [id])

  @@unique([productId, uomId], map: "product_uoms_product_uom_uq")
  @@index([productId], map: "idx_product_uoms_product_id")
  @@index([uomId], map: "idx_product_uoms_uom_id")
  @@map("product_uoms")
}

model ProductUomPrice {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  uomId              String    @map("uom_id") @db.Uuid
  sellingPrice       Decimal?  @map("selling_price") @db.Decimal(14, 2)
  costPrice          Decimal?  @map("cost_price") @db.Decimal(14, 4)
  initialCostPrice   Decimal?  @map("initial_cost_price") @db.Decimal(14, 4)
  lastPurchaseCost   Decimal?  @map("last_purchase_cost") @db.Decimal(14, 4)
  lastPurchaseAt     DateTime? @map("last_purchase_at") @db.Timestamp(6)
  lastPurchaseId     String?   @map("last_purchase_id") @db.Uuid
  lastPurchaseItemId String?   @map("last_purchase_item_id") @db.Uuid
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom              Uom           @relation(fields: [uomId], references: [id])
  lastPurchase     Purchase?     @relation(fields: [lastPurchaseId], references: [id], onDelete: SetNull)
  lastPurchaseItem PurchaseItem? @relation(fields: [lastPurchaseItemId], references: [id], onDelete: SetNull)

  @@index([productId, uomId], map: "idx_product_uom_prices_product_uom")
  @@map("product_uom_prices")
}

model ProductUomBarcode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  uomId     String   @map("uom_id") @db.Uuid
  barcode   String   @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom     Uom     @relation(fields: [uomId], references: [id])

  @@index([productId, uomId], map: "idx_product_uom_barcodes_product_uom")
  @@index([barcode], map: "idx_product_uom_barcodes_barcode")
  @@map("product_uom_barcodes")
}

model Supplier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?  @db.VarChar(255)
  supplierType String   @default("local") @map("supplier_type") @db.VarChar(20)
  country      String?  @db.VarChar(100)
  city         String?  @db.VarChar(100)
  phone        String?  @db.VarChar(50)
  email        String?  @db.VarChar(255)
  address      String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  products             Product[]
  productSuppliers     ProductSupplier[]
  supplierUomCosts     ProductSupplierUomCost[]
  supplierPriceHistory SupplierPriceHistory[]
  purchases            Purchase[]
  @@map("suppliers")
}

model ProductSupplier {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  isPreferred      Boolean  @default(false) @map("is_preferred")
  lastCostPrice    Decimal? @map("last_cost_price") @db.Decimal(10, 2)
  supplierItemCode String?  @map("supplier_item_code") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId], map: "product_suppliers_product_supplier_uq")
  @@index([productId, isPreferred], map: "idx_product_suppliers_product_preferred")
  @@index([supplierId, productId], map: "idx_product_suppliers_supplier_product")
  @@map("product_suppliers")
}

model ProductSupplierUomCost {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  supplierId         String    @map("supplier_id") @db.Uuid
  uomId              String    @map("uom_id") @db.Uuid
  currentCostPrice   Decimal?  @map("current_cost_price") @db.Decimal(14, 4)
  lastPurchaseCost   Decimal?  @map("last_purchase_cost") @db.Decimal(14, 4)
  lastPurchaseAt     DateTime? @map("last_purchase_at") @db.Timestamp(6)
  lastPurchaseId     String?   @map("last_purchase_id") @db.Uuid
  lastPurchaseItemId String?   @map("last_purchase_item_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier         Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uom              Uom           @relation(fields: [uomId], references: [id])
  lastPurchase     Purchase?     @relation(fields: [lastPurchaseId], references: [id], onDelete: SetNull)
  lastPurchaseItem PurchaseItem? @relation(fields: [lastPurchaseItemId], references: [id], onDelete: SetNull)

  @@unique([productId, supplierId, uomId], map: "product_supplier_uom_costs_product_supplier_uom_uq")
  @@index([supplierId, productId, uomId], map: "idx_product_supplier_uom_costs_lookup")
  @@index([productId, uomId], map: "idx_product_supplier_uom_costs_product_uom")
  @@map("product_supplier_uom_costs")
}

model SupplierPriceHistory {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId                String    @map("product_id") @db.Uuid
  supplierId               String    @map("supplier_id") @db.Uuid
  uomId                    String    @map("uom_id") @db.Uuid
  purchaseId               String?   @map("purchase_id") @db.Uuid
  purchaseItemId           String?   @map("purchase_item_id") @db.Uuid
  oldCostPrice             Decimal?  @map("old_cost_price") @db.Decimal(14, 4)
  newCostPrice             Decimal   @map("new_cost_price") @db.Decimal(14, 4)
  enteredQuantity          Decimal?  @map("entered_quantity") @db.Decimal(14, 4)
  baseQuantity             Int?      @map("base_quantity")
  conversionFactorSnapshot Decimal?  @map("conversion_factor_snapshot") @db.Decimal(18, 6)
  purchaseDate             DateTime? @map("purchase_date") @db.Date
  source                   String    @default("purchase_invoice") @db.VarChar(50)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uom          Uom           @relation(fields: [uomId], references: [id])
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  @@index([productId, supplierId, uomId, createdAt(sort: Desc)], map: "idx_supplier_price_history_lookup")
  @@index([purchaseId], map: "idx_supplier_price_history_purchase")
  @@map("supplier_price_history")
}

model PriceGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  productPrices    ProductPriceGroupPrice[]
  priceHistory     ProductPriceHistory[]
  offers           OfferList[]
  saleItems        SaleItem[]
  offerRedemptions OfferRedemption[]

  @@map("price_groups")
}

model ProductPriceGroupPrice {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  uomId        String   @map("uom_id") @db.Uuid
  priceGroupId String   @map("price_group_id") @db.Uuid
  sellingPrice Decimal  @map("selling_price") @db.Decimal(14, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom        Uom        @relation(fields: [uomId], references: [id])
  priceGroup PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  @@index([productId, uomId, priceGroupId], map: "idx_product_price_group_prices_lookup")
  @@index([priceGroupId, active], map: "idx_product_price_group_prices_group_active")
  @@map("product_price_group_prices")
}

model ProductPriceHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  uomId           String?  @map("uom_id") @db.Uuid
  priceGroupId    String?  @map("price_group_id") @db.Uuid
  oldSellingPrice Decimal? @map("old_selling_price") @db.Decimal(14, 2)
  newSellingPrice Decimal? @map("new_selling_price") @db.Decimal(14, 2)
  oldCostPrice    Decimal? @map("old_cost_price") @db.Decimal(14, 4)
  newCostPrice    Decimal? @map("new_cost_price") @db.Decimal(14, 4)
  changeReason    String?  @map("change_reason") @db.Text
  source          String   @default("manual") @db.VarChar(50)
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom        Uom?        @relation(fields: [uomId], references: [id])
  priceGroup PriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)], map: "idx_product_price_history_product_created")
  @@index([priceGroupId, createdAt(sort: Desc)], map: "idx_product_price_history_group_created")
  @@map("product_price_history")
}

model OfferList {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no                 String    @unique @db.VarChar(50)
  description        String    @db.Text
  status             String    @default("disabled") @db.VarChar(20)
  priceGroupId       String?   @map("price_group_id") @db.Uuid
  priority           Int       @default(0)
  validationPeriodId String?   @map("validation_period_id") @db.VarChar(100)
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  offerType          String    @map("offer_type") @db.VarChar(50)
  discountType       String    @map("discount_type") @db.VarChar(50)
  discountValue      Decimal   @default(0) @map("discount_value") @db.Decimal(14, 2)
  applyTo            String    @default("product") @map("apply_to") @db.VarChar(50)
  branchScope        String    @default("all") @map("branch_scope") @db.VarChar(50)
  stackingEnabled    Boolean   @default(false) @map("stacking_enabled")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  priceGroup  PriceGroup?       @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  rules       OfferRule[]
  saleItems   SaleItem[]
  redemptions OfferRedemption[]

  @@index([status, startDate, endDate, priority], map: "idx_offer_lists_status_dates_priority")
  @@index([priceGroupId, status], map: "idx_offer_lists_group_status")
  @@map("offer_lists")
}

model OfferRule {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId          String   @map("offer_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  categoryId       String?  @map("category_id") @db.Uuid
  minQuantity      Decimal? @map("min_quantity") @db.Decimal(14, 4)
  buyQuantity      Decimal? @map("buy_quantity") @db.Decimal(14, 4)
  getQuantity      Decimal? @map("get_quantity") @db.Decimal(14, 4)
  specialPrice     Decimal? @map("special_price") @db.Decimal(14, 2)
  bundleProductIds Json?    @map("bundle_product_ids")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  offer    OfferList        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([offerId], map: "idx_offer_rules_offer_id")
  @@index([productId], map: "idx_offer_rules_product_id")
  @@index([categoryId], map: "idx_offer_rules_category_id")
  @@map("offer_rules")
}

model OfferRedemption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId        String   @map("offer_id") @db.Uuid
  saleId         String?  @map("sale_id") @db.Uuid
  saleItemId     String?  @map("sale_item_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  priceGroupId   String?  @map("price_group_id") @db.Uuid
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  offer      OfferList   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItem   SaleItem?   @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  priceGroup PriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt(sort: Desc)], map: "idx_offer_redemptions_offer_created")
  @@index([saleId], map: "idx_offer_redemptions_sale_id")
  @@map("offer_redemptions")
}

model Customer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?  @db.VarChar(255)
  phone        String?  @db.VarChar(50)
  address      String?  @db.Text
  customerNo   String?  @map("customer_no") @db.VarChar(32)
  creditLimit  Decimal? @map("credit_limit") @db.Decimal(12, 2)
  creditStatus String   @default("active") @map("credit_status") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  memberCardNo String?  @map("member_card_no") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  patientLoans PatientLoan[]
  sales        Sale[]
  @@map("customers")
}

model PatientLoan {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  saleId      String?   @map("sale_id") @db.Uuid
  totalAmount Decimal   @map("total_amount") @db.Decimal(12, 2)
  amountPaid  Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status      String    @default("ongoing") @db.VarChar(20)
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch?              @relation(fields: [branchId], references: [id])
  sale     Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments PatientLoanPayment[]

  @@index([branchId])
  @@index([customerId])
  @@map("patient_loans")
}

model PatientLoanPayment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId        String   @map("loan_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
